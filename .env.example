# BridgeCare backend configuration.
# Copy to `.env` and fill in values. Never commit a real `.env`.
# Every value below is read from the environment by app/core/config.py.

# Required in staging/production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
BRIDGECARE_SECRET_KEY=

# development | test | staging | production
BRIDGECARE_ENVIRONMENT=development

# PostgreSQL is the supported deployment database.
BRIDGECARE_DATABASE_URL=postgresql+psycopg://bridgecare:bridgecare@127.0.0.1:5432/bridgecare

# Private directory for uploaded medical documents (never served statically).
BRIDGECARE_STORAGE_ROOT=./var/documents
BRIDGECARE_MAX_UPLOAD_BYTES=20971520

# Token lifetimes
BRIDGECARE_ACCESS_TOKEN_MINUTES=30
BRIDGECARE_REFRESH_TOKEN_DAYS=14
BRIDGECARE_SHARE_LINK_MAX_DAYS=30

# Shared secret used only by the internal AI engine contract endpoints.
# Leave empty to disable those endpoints entirely.
BRIDGECARE_AI_SERVICE_KEY=

# Outbound hospital directory integration: none | configured
BRIDGECARE_HOSPITAL_DIRECTORY_PROVIDER=none

# IDTA malware scanning adapter: none | stub. With ``none`` no document can ever
# become "clean", so AI processing (including insurance extraction) is refused.
# ``stub`` is a deterministic test adapter, not a real antivirus engine.
BRIDGECARE_DOCUMENT_SCANNER=none

# Insurer verification provider: none | stub. Only this boundary can produce
# INSURER_VERIFIED coverage; ``none`` makes the verify endpoint return 503.
BRIDGECARE_INSURER_VERIFICATION_PROVIDER=none

# Contract version shared with the AI engine for insurance extraction.
BRIDGECARE_INSURANCE_CONTRACT_VERSION=2026-11-insurance-contract-v1

# Browser origins allowed to call the API, comma-separated. Empty disables CORS.
# Example: BRIDGECARE_ALLOWED_ORIGINS=http://localhost:5173,https://app.example.com
BRIDGECARE_ALLOWED_ORIGINS=
