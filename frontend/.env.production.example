# Production build configuration
#
# Copy to .env.production, or set the same variable in the integration build
# environment. `npm run build` bakes this value into the bundle, so it must be
# the deployed API origin, never localhost.
#
# The build fails if this is set to a loopback host, and the built app refuses
# to start if it is missing (see src/api/client.js).
VITE_API_BASE_URL=https://api.your-domain.example/api/v1
